# Local end-to-end environment for the AI screening flow. Loaded by the `e2e:*` npm scripts via
# `node --env-file`, ahead of `.env` — values here win, `.env` fills in anything not listed.
#
# Everything points at local stand-ins, so nothing here is a secret and nothing touches a shared
# database, the real Firebase project, S3 or a billed AI provider:
#   Postgres  docker container modfanart-postgres  127.0.0.1:5434
#   Redis     docker container modfanart-redis     127.0.0.1:6381
#   S3        docker container modfanart-minio     127.0.0.1:9000 (bucket modfanart-local)
#   Firebase  Auth emulator                        127.0.0.1:9099
# `npm run e2e:services` creates or starts the containers.

DATABASE_URL=postgres://modfanart:modfanart@127.0.0.1:5434/modfanart_dev
DB_SSL=false
REDIS_URL=redis://127.0.0.1:6381

# firebase-admin verifies emulator-issued tokens when this is set. The empty credentials path stops
# it reaching for a service-account file that is not needed against the emulator.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GOOGLE_CLOUD_PROJECT=modfanart
GOOGLE_APPLICATION_CREDENTIALS=

AWS_ACCESS_KEY_ID=modfanart
AWS_SECRET_ACCESS_KEY=modfanart-secret
AWS_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET_NAME=modfanart-local
CDN_BASE_URL=http://127.0.0.1:9000/modfanart-local

# Fake AI providers; artwork titles steer the verdicts (see postman/README.md). Remove this and set
# AIORNOT_API_KEY / OPENAI_API_KEY to screen against the real providers.
SCREENING_ADAPTERS=mock

FRONTEND_URL=http://localhost:3000
PORT=5000
