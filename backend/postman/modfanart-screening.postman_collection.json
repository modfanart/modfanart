              ]
            },
            "description": "Every new route sits behind authenticateToken. Expect 401 'No token provided'."
          }
        },
        {
          "name": "18 Bad UUID → 400 with field detail",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/screening/runs",
              "host": [
